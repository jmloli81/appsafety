{
  "expo": {
    "name": "App Safety",
    "slug": "appsafety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dhl.png",
    "scheme": "appsafety",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.appsafety.app",
      "adaptiveIcon": {
        "backgroundColor": "#e39229",
        "foregroundImage": "./assets/images/dhl.png",
        "backgroundImage": "./assets/images/dhl.png",
        "monochromeImage": "./assets/images/dhl.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/dhl.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c9285ea6-7477-419c-bf5a-501b483316ed"
      }
    }
  }
}
